---
import {
  SITE_URL,
  SITE_NAME,
  OG_IMAGE_URL,
  ACQUISITION_EMAIL,
  ASKING_PRICE_VALUE,
} from '../lib/constants';

interface Props {
  extraSchema?: Record<string, unknown>[];
}

const { extraSchema = [] } = Astro.props;

const description =
  'Acquire icrabuilders.com — the clean, premium .com brand for ICRA Builders. The authoritative name for specialized healthcare construction, ICRA compliance, training, and services.';

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  inLanguage: 'en-US',
  description,
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
    email: ACQUISITION_EMAIL,
  },
};

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `icrabuilders.com — Premium ICRA Builders Domain for Sale`,
  description,
  url: SITE_URL,
  inLanguage: 'en-US',
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: OG_IMAGE_URL,
    contentUrl: OG_IMAGE_URL,
    width: 1200,
    height: 630,
  },
  about: {
    '@type': 'Thing',
    name: 'ICRA Builders Domain',
    description:
      'Premium .com domain name asset for ICRA construction expertise, ICRA compliance training, and infection control risk assessment services.',
  },
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  email: ACQUISITION_EMAIL,
  logo: OG_IMAGE_URL,
  description,
  sameAs: [SITE_URL],
};

const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'icrabuilders.com domain name',
  description:
    'Premium .com domain for ICRA Builders in healthcare construction. The authoritative brand for ICRA compliance, training, and specialized construction services.',
  image: OG_IMAGE_URL,
  url: SITE_URL,
  category: 'Domain Name',
  sku: 'icrabuilders.com',
  mpn: 'icrabuilders.com',
  brand: {
    '@type': 'Brand',
    name: 'ICRA Builders',
  },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    price: ASKING_PRICE_VALUE,
    priceCurrency: 'USD',
    priceValidUntil: '2027-12-31',
    seller: {
      '@type': 'Organization',
      email: ACQUISITION_EMAIL,
    },
    url: SITE_URL,
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: '0.00',
        currency: 'USD',
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 1,
          unitCode: 'DAY',
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 0,
          unitCode: 'DAY',
        },
      },
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: 'US',
      },
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
      applicableCountry: 'US',
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(webSite)} />
<script type="application/ld+json" set:html={JSON.stringify(webPage)} />
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
<script type="application/ld+json" set:html={JSON.stringify(product)} />
{
  extraSchema.map(
    (schema) => (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...schema })} />
    ),
  )
}
