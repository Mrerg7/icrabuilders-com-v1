---
import { SITE_NAME, ACQUISITION_EMAIL, ASKING_PRICE, acquisitionMailto } from '../lib/constants';

const mailto = acquisitionMailto();
---

<div id="inquiry-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden max-h-[90vh] overflow-y-auto">
    <!-- Modal Header -->
    <div class="px-6 sm:px-7 pt-6 pb-4 bg-slate-900 text-white flex justify-between items-center gap-4">
      <div class="min-w-0">
        <div id="modal-title" class="font-semibold text-lg sm:text-xl tracking-tight truncate">Acquire {SITE_NAME}</div>
        <div class="text-teal-400 text-sm">Confidential inquiry · Asking {ASKING_PRICE}</div>
      </div>
      <button id="modal-close-btn" class="shrink-0 text-white/60 hover:text-white w-10 h-10 flex items-center justify-center" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <form id="inquiry-form" action="https://formsubmit.co/sales@desertrich.com" method="POST" class="p-6 sm:p-7 space-y-5">
      <input type="hidden" name="_subject" value="icrabuilders.com Acquisition Inquiry" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value="https://icrabuilders.com/#acquire" />
      <input type="hidden" name="Domain" value="icrabuilders.com" />
      <input type="hidden" name="Asking price" value={ASKING_PRICE} />
      <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
        <div>
          <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-1.5" for="full-name">FULL NAME</label>
          <input type="text" id="full-name" name="Name" required class="w-full border border-slate-200 focus:border-teal-500 outline-none px-4 py-3 rounded-2xl text-sm" placeholder="Taylor Morgan" autocomplete="name" />
        </div>
        <div>
          <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-1.5" for="company">COMPANY / ORGANIZATION</label>
          <input type="text" id="company" name="Company" class="w-full border border-slate-200 focus:border-teal-500 outline-none px-4 py-3 rounded-2xl text-sm" placeholder="Your Company or 'Individual'" autocomplete="organization" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
        <div>
          <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-1.5" for="email">EMAIL ADDRESS</label>
          <input type="email" id="email" name="Email" required class="w-full border border-slate-200 focus:border-teal-500 outline-none px-4 py-3 rounded-2xl text-sm" placeholder="you@company.com" autocomplete="email" />
        </div>
        <div>
          <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-1.5" for="phone">PHONE (OPTIONAL)</label>
          <input type="tel" id="phone" name="Phone" class="w-full border border-slate-200 focus:border-teal-500 outline-none px-4 py-3 rounded-2xl text-sm" placeholder="(602) 555-0199" autocomplete="tel" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-1.5" for="offer">OFFER (USD, OPTIONAL)</label>
        <input type="text" id="offer" name="Offer" inputmode="numeric" class="w-full border border-slate-200 focus:border-teal-500 outline-none px-4 py-3 rounded-2xl text-sm" placeholder={`e.g. ${ASKING_PRICE.replace('$', '')}`} />
      </div>

      <div>
        <label class="block text-xs font-semibold tracking-wider text-slate-500 mb-1.5" for="message">TELL US ABOUT YOUR INTEREST</label>
        <textarea id="message" name="Message" rows="4" class="w-full border border-slate-200 focus:border-teal-500 outline-none px-4 py-3.5 rounded-3xl text-sm resize-y min-h-[92px]" placeholder="I'm interested in acquiring icrabuilders.com to establish a professional ICRA construction and compliance brand. My background is in..."></textarea>
      </div>

      <div class="pt-1">
        <button type="submit"
                class="w-full py-4 bg-teal-600 hover:bg-teal-700 active:bg-teal-800 transition-colors text-white font-semibold rounded-3xl flex items-center justify-center gap-x-2 text-base shadow-sm">
          <span id="submit-label">Submit Confidential Inquiry</span>
        </button>
        <p id="form-status" role="status" aria-live="polite" class="text-sm text-center min-h-[1.25rem] mt-3 text-slate-600"></p>
        <p class="text-center text-[11px] text-slate-400">We typically respond within 24 hours. All inquiries are kept strictly confidential.</p>
        <p class="text-center text-xs text-slate-500 mt-3">
          Prefer email? <a href={mailto} class="text-teal-600 hover:text-teal-700 font-medium underline underline-offset-2">{ACQUISITION_EMAIL}</a>
        </p>
      </div>
    </form>
  </div>
</div>

<script>
  import { ACQUISITION_EMAIL } from '../lib/constants';

  function showModal() {
    const modal = document.getElementById('inquiry-modal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        document.getElementById('full-name')?.focus();
      }, 300);
    }
  }

  function hideModal() {
    const modal = document.getElementById('inquiry-modal');
    if (modal) {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  document.getElementById('modal-close-btn')?.addEventListener('click', hideModal);
  document.getElementById('inquiry-modal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) hideModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('inquiry-modal');
      if (modal && !modal.classList.contains('hidden')) {
        hideModal();
      }
    }
  });

  const inquiryForm = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const submitBtn = document.querySelector<HTMLButtonElement>('#inquiry-form button[type="submit"]');
  const submitLabel = document.getElementById('submit-label');
  const formStatus = document.getElementById('form-status');

  inquiryForm?.addEventListener('submit', async (e) => {
    // Honeypot: silently drop bot submissions.
    const honey = inquiryForm.querySelector<HTMLInputElement>('input[name="_honey"]');
    if (honey?.value) {
      e.preventDefault();
      return;
    }

    e.preventDefault();
    if (!submitBtn || !submitLabel || !formStatus) return;

    submitBtn.disabled = true;
    submitLabel.textContent = 'Sending…';
    formStatus.textContent = '';
    formStatus.classList.remove('text-emerald-600', 'text-red-500');

    try {
      const res = await fetch(`https://formsubmit.co/ajax/${ACQUISITION_EMAIL}`, {
        method: 'POST',
        body: new FormData(inquiryForm),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('request failed');

      inquiryForm.innerHTML = `<div class="py-8 text-center">
        <div class="mx-auto w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="font-semibold text-2xl tracking-tight text-slate-900 mb-2">Inquiry Received</h3>
        <p class="text-slate-600 max-w-xs mx-auto">Thank you. A member of our acquisition team will contact you within 24 hours to discuss next steps confidentially.</p>
        <button type="button" class="mt-8 px-8 py-3 text-sm font-semibold border border-slate-200 hover:bg-slate-50 rounded-3xl transition-colors" id="close-success-btn">Close Window</button>
      </div>`;
      document.getElementById('close-success-btn')?.addEventListener('click', hideModal);
    } catch {
      submitBtn.disabled = false;
      submitLabel.textContent = 'Submit Confidential Inquiry';
      formStatus.textContent = `Sending failed — please email ${ACQUISITION_EMAIL} directly.`;
      formStatus.classList.add('text-red-500');
    }
  });

  // Expose for external triggers
  (window as any).showInquiryModal = showModal;
  (window as any).hideInquiryModal = hideModal;
</script>
